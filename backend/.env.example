PORT=4000
RPC_URL=http://127.0.0.1:8545
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# 32+ random characters. Generate with: npm run gen-env
JWT_SECRET=
JWT_TTL=2h
# 64 hex chars (32 bytes) AES-256-GCM key. Losing it = losing access to stored reports.
REPORT_ENCRYPTION_KEY=
